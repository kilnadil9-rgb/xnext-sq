# XNEXT Environment (copy to .env.local for local dev)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=ey...
VITE_GOOGLE_MAPS_API_KEY=...
VITE_GOOGLE_MAPS_MAP_ID=...
VITE_DEFAULT_RADIUS_KM=25

# Stripe (shared account with VHS Live, but separated by metadata)
# Set these in Supabase Edge Functions secrets (not client):
#   STRIPE_SECRET_KEY=sk_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   SITE_URL=https://xnext.app
#
# Client-safe publishable (for future Stripe.js if needed):
VITE_STRIPE_PUBLISHABLE_KEY=pk_...
